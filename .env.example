# Copy to your deployment environment. Never commit real secrets.
DATABASE_URL=postgresql://pan:pan_local_password@localhost:5432/pan?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-a-legacy-internal-api-secret-at-least-32-characters
EXPORT_ENCRYPTION_KEY=replace-with-64-hex-characters-from-32-random-bytes
SUPER_ADMIN_EMAIL=security-admin@your-domain.example
SUPER_ADMIN_PASSWORD_HASH=generate-a-bcrypt-hash-and-store-it-here
PUBLIC_VERIFY_URL=http://localhost:3001
MANUFACTURER_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAN_API_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PAN Network <no-reply@your-domain.example>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

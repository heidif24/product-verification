# Copy to .env at the repository root. Replace every secret before use.
DATABASE_URL=postgresql://pan:pan_local_password@localhost:5432/pan?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-another-random-secret-at-least-32-characters
PUBLIC_VERIFY_URL=http://localhost:3001
NEXT_PUBLIC_PAN_API_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000

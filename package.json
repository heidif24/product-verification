{
  "name": "pan-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo run typecheck",
    "typecheck": "turbo typecheck",
    "dev:api": "pnpm --filter @pan/api dev",
    "dev:manufacturer": "pnpm --filter @pan/manufacturer-web dev",
    "dev:verify": "pnpm --filter @pan/verification-web dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "pnpm": {
    "overrides": {
      "react@^19.0.0": "19.0.0",
      "react-dom@^19.0.0": "19.0.0",
      "@types/react@^19.0.2": "19.0.2",
      "@types/react-dom@^19.0.2": "19.0.2"
    }
  }
}
